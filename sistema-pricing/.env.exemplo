# Segredos da Edge Function "api" (supabase secrets set ...). Nada disto vai para o navegador nem para o repositório.
# SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY e SUPABASE_DB_URL já existem no ambiente das funções.
URL_APLICACAO=https://cotacao.cliente.com.br
ORIGENS_PERMITIDAS=
AMBIENTE=producao                 # producao | homologacao | demonstracao
SEGREDO_HASH=                     # 32+ caracteres aleatórios (HMAC de documentos)
CHAVE_CIFRA_DOCUMENTOS=           # 32+ caracteres aleatórios (cifra de coluna); guarde no cofre do cliente
SEGREDO_AUTOMACAO=                # 24+ caracteres; credencial própria do n8n
N8N_WEBHOOK_URL=                  # opcional
ANTHROPIC_API_KEY=                # opcional: sem ela o assistente fica desligado e o resto funciona
SEGREDO_PSEUDONIMO=               # 32+ caracteres; códigos pseudônimos do pacote ao diagnóstico (A10). Nunca sai do servidor
CHAVE_ENVIO_DIAGNOSTICO=          # opcional: chave que só deposita pacotes no diagnóstico; sem ela o envio não sai
FUSO_HORARIO=America/Sao_Paulo

# Cópia externa (servidor do n8n ou agendador do cliente)
COPIA_DESTINO=/mnt/copias-do-cliente
COPIA_SENHA=                      # 16+ caracteres; sem ela a cópia não abre
