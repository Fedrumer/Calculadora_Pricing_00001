        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"ids\": [ $('Montar mensagens').item.json.id ] } }}"
      },
      "id": "799e92f8-d76a-45ce-94ed-b1b098786775",
      "name": "Confirmar entrega",
