    {
      "parameters": {
        "jsCode": "const d = $input.first().json;\n// sem alerta novo hoje: nada a enviar (cada alerta sai uma vez por dia)\nif (!d.alertas || d.alertas.length === 0 || !d.para || d.para.length === 0) return [];\nreturn [{ json: { para: d.para.join(','), assunto: `Pricing: margem e desconto do mês (${d.alertas.length})`, texto: [...d.alertas.map((a) => '- ' + a.mensagem), '', 'Alerta automático do sistema de pricing. A PTAX e os indicadores nunca mudam preço sozinhos: a decisão é do gestor.'].join('\\n') } }];"
      },
